{
  "name": "stratum-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "gen:api": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/api/gen --ts_proto_opt=useJsonWireFormat=true,snakeToCamel=false,forceLong=string,onlyTypes=true,esModuleInterop=true -I ../api/proto query.proto knowledgebase.proto admin.proto"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "@tauri-apps/api": "^2.11.1",
    "mammoth": "^1.12.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ts-proto": "^2.12.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
